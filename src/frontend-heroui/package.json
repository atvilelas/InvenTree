{
  "name": "vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "yarn extractIcons && vite",
    "build": "yarn extractIcons && tsc && vite build --emptyOutDir",
    "lib": "yarn extractIcons && tsc --p ./tsconfig.lib.json && vite --config vite.lib.config.ts build",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript",
    "lint": "eslint -c .eslintrc.json ./src/**/**/*.{ts,tsx} --fix",
    "preview": "vite preview",
    "extractIcons": "vite-node ./lib/scripts/extractIcons.ts"
  },
  "dependencies": {
    "@heroui/badge": "^2.2.10",
    "@heroui/button": "2.2.17",
    "@heroui/card": "^2.2.16",
    "@heroui/checkbox": "^2.3.16",
    "@heroui/code": "2.2.12",
    "@heroui/divider": "^2.2.11",
    "@heroui/dropdown": "2.3.17",
    "@heroui/form": "^2.1.16",
    "@heroui/input": "^2.4.17",
    "@heroui/kbd": "2.2.13",
    "@heroui/link": "^2.2.14",
    "@heroui/navbar": "2.2.15",
    "@heroui/snippet": "2.2.18",
    "@heroui/switch": "2.2.15",
    "@heroui/system": "2.4.13",
    "@heroui/theme": "2.4.13",
    "@heroui/toast": "^2.0.7",
    "@heroui/use-theme": "^2.1.6",
    "@lingui/core": "^5.3.1",
    "@lingui/react": "^5.3.1",
    "@react-aria/visually-hidden": "3.8.21",
    "@react-types/shared": "3.28.0",
    "@tanstack/react-query": "^5.74.4",
    "@types/axios": "^0.14.4",
    "axios": "^1.8.4",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "6.23.0",
    "recharts": "^2.15.3",
    "tailwind-variants": "0.3.0",
    "tailwindcss": "3.4.16",
    "usehooks-ts": "^3.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@iconify/react": "^5.2.1",
    "@lingui/babel-plugin-lingui-macro": "^5.3.1",
    "@lingui/macro": "^5.3.1",
    "@types/node": "20.5.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.19",
    "babel-plugin-macros": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.23.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "node-tsc": "^0.0.14",
    "postcss": "8.4.38",
    "prettier": "3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "vite": "^5.2.0",
    "vite-node": "^3.1.2",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
